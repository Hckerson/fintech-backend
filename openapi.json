                                        }
                                    ]
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearer": []
                    }
                ],
                "summary": "Users created in one day, month or year (Admin only)",
                "tags": [
                    "stats"
                ]
            }
        },
