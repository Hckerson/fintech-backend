    "info": {
        "title": "API",
        "description": "Backend REST API documentation",
        "version": "1.0",
        "contact": {}
    },
    "tags": [],
    "servers": [],
    "components": {
        "securitySchemes": {
            "bearer": {
                "scheme": "bearer",
                "bearerFormat": "JWT",
                "type": "http"
            }
        },
        "schemas": {
            "ApiEnvelopeDto": {
                "type": "object",
                "properties": {
                    "statusCode": {
                        "type": "number"
                    },
                    "message": {
                        "type": "string"
                    },
                    "timestamp": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "required": [
                    "statusCode",
                    "message",
                    "timestamp"
                ]
            },
            "AuthResponseUserDto": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "role": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "email",
                    "role"
                ]
            },
            "AuthResponseDto": {
                "type": "object",
                "properties": {
                    "user": {
                        "$ref": "#/components/schemas/AuthResponseUserDto"
                    },
                    "accessToken": {
                        "type": "string"
                    }
                },
                "required": [
                    "user"
                ]
            },
            "RegisterDto": {
                "type": "object",
                "properties": {
                    "fullName": {
                        "type": "string",
                        "example": "John Doe"
                    },
                    "email": {
                        "type": "string",
                        "example": "john@example.com"
                    },
                    "password": {
                        "type": "string",
                        "example": "password123",
                        "minLength": 8
                    },
                    "phoneNumber": {
                        "type": "string",
                        "example": "+1234567890"
                    }
                },
                "required": [
                    "fullName",
                    "email",
                    "password"
                ]
            },
            "LoginDto": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "example": "john@example.com"
                    },
                    "password": {
                        "type": "string",
                        "example": "password123"
                    }
                },
                "required": [
                    "email",
                    "password"
                ]
            },
            "UserResponseDto": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "fullName": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "phoneNumber": {
                        "type": "string",
                        "nullable": true
                    },
                    "avatar": {
                        "type": "string",
                        "nullable": true
                    },
                    "bio": {
                        "type": "string",
                        "nullable": true
                    },
                    "role": {
                        "type": "string",
                        "enum": [
                            "ADMIN",
                            "USER"
                        ]
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "ACTIVE",
                            "PENDING",
                            "SUSPENDED"
                        ]
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "lastActive": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    }
                },
                "required": [
                    "id",
                    "fullName",
                    "email",
                    "phoneNumber",
                    "avatar",
                    "bio",
                    "role",
                    "status",
                    "createdAt",
                    "updatedAt",
                    "lastActive"
                ]
            },
            "CreateUserDto": {
                "type": "object",
                "properties": {
                    "fullName": {
                        "type": "string",
                        "example": "John Doe"
                    },
                    "email": {
                        "type": "string",
                        "example": "john@example.com"
                    },
                    "password": {
                        "type": "string",
                        "example": "password123",
                        "minLength": 8
                    },
                    "role": {
                        "type": "string",
                        "enum": [
                            "ADMIN",
                            "USER"
                        ],
                        "default": "USER"
                    },
                    "phoneNumber": {
                        "type": "string",
                        "example": "+1234567890"
                    },
                    "bio": {
                        "type": "string",
                        "example": "Short profile bio"
                    }
                },
                "required": [
                    "fullName",
                    "email",
                    "password"
                ]
            },
            "UpdateUserDto": {
                "type": "object",
                "properties": {
                    "fullName": {
                        "type": "string",
                        "example": "John Doe"
                    },
                    "email": {
                        "type": "string",
                        "example": "john@example.com"
                    },
                    "password": {
                        "type": "string",
                        "example": "password123",
                        "minLength": 8
                    },
                    "role": {
                        "type": "string",
                        "enum": [
                            "ADMIN",
                            "USER"
                        ],
                        "default": "USER"
                    },
                    "phoneNumber": {
                        "type": "string",
                        "example": "+1234567890"
                    },
                    "bio": {
                        "type": "string",
                        "example": "Short profile bio"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "ACTIVE",
                            "PENDING",
                            "SUSPENDED"
                        ]
                    }
                }
            },
            "HealthResponseDto": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "enum": [
                            "ok"
                        ]
                    }
                },
                "required": [
                    "status"
                ]
            },
            "PeriodTotalResponseDto": {
                "type": "object",
                "properties": {
                    "period": {
                        "type": "string",
                        "enum": [
                            "day",
                            "month",
                            "year"
                        ]
                    },
                    "start": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "end": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "total": {
                        "type": "number"
                    }
                },
                "required": [
                    "period",
                    "start",
                    "end",
                    "total"
                ]
            },
            "SeriesPointDto": {
                "type": "object",
                "properties": {
                    "key": {
                        "type": "string",
                        "example": "2026-09"
                    },
                    "value": {
                        "type": "number"
                    }
                },
                "required": [
                    "key",
                    "value"
                ]
            },
            "PeriodSeriesResponseDto": {
                "type": "object",
                "properties": {
                    "period": {
                        "type": "string",
                        "enum": [
                            "day",
                            "month",
                            "year"
                        ]
                    },
                    "start": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "end": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "points": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/SeriesPointDto"
                        }
                    }
                },
                "required": [
                    "period",
                    "start",
                    "end",
                    "points"
                ]
            },
            "MoneyDto": {
                "type": "object",
                "properties": {
                    "amountMinor": {
                        "type": "string",
                        "example": "-125000",
                        "description": "Signed integer in minor units."
                    },
                    "currency": {
                        "type": "string",
                        "example": "GBP",
                        "description": "ISO 4217 code."
                    }
                },
                "required": [
                    "amountMinor",
                    "currency"
                ]
            },
            "AccountResponseDto": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "kind": {
                        "type": "string",
                        "enum": [
                            "OPERATING",
                            "RESERVE",
                            "SAVINGS"
                        ]
                    },
                    "last4": {
                        "type": "string",
                        "example": "4821"
                    },
                    "currency": {
                        "type": "string",
                        "example": "GBP"
                    },
                    "available": {
                        "$ref": "#/components/schemas/MoneyDto"
                    },
                    "current": {
                        "$ref": "#/components/schemas/MoneyDto"
                    },
                    "state": {
                        "type": "string",
                        "enum": [
                            "OPEN",
                            "FROZEN",
                            "CLOSED"
                        ]
                    },
                    "openedAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "kind",
                    "last4",
                    "currency",
                    "available",
                    "current",
                    "state",
                    "openedAt"
                ]
            },
            "CashFlowPointDto": {
                "type": "object",
                "properties": {
                    "inflow": {
                        "$ref": "#/components/schemas/MoneyDto"
                    },
                    "outflow": {
                        "$ref": "#/components/schemas/MoneyDto"
                    },
                    "net": {
                        "$ref": "#/components/schemas/MoneyDto"
                    },
                    "periodStart": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "required": [
                    "inflow",
                    "outflow",
