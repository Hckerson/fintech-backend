                    },
                    {
                        "name": "date",
                        "required": false,
                        "in": "query",
                        "description": "Any instant inside the period. Defaults to now.",
                        "schema": {
                            "example": "2026-09-22",
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
